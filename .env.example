# Copier en .env sur le serveur (chmod 600), jamais dans git.

# --- Identifiants IBKR (lus seulement par IB Gateway) ---
TWS_USERID=
TWS_PASSWORD=
TRADING_MODE=live            # live ou paper
VNC_SERVER_PASSWORD=         # facultatif, pour voir l'écran de Gateway via tunnel SSH

# --- Robot ---
IB_ACCOUNT_ID=               # ex. U1234567 : le robot refuse tout autre compte
IB_PORT=4003                 # 4003 en live, 4004 en paper
DRY_RUN=true                 # true = simulation. Passer à false pour trader réellement.

# Garde-fous (fractions de la NAV)
RISK_PER_TRADE=0.02
RISK_TOLERANCE=0.10
MAX_PREMIUM_PER_TRADE=0.03
MAX_TOTAL_RISK=0.10
MAX_NEW_ORDERS_PER_DAY=3
MAX_CONTRACTS_PER_ORDER=5

POLL_SECONDS=60
NTFY_URL=                    # ex. https://ntfy.sh/un-nom-long-et-secret : alertes sur le téléphone

# --- Desk Flow (scanner horaire Unusual Whales → tickets → robot) ---
UW_TOKEN=                    # clé API Unusual Whales (https://unusualwhales.com/api) : lue seulement par le scanner
NAV_USD=                     # repli si IB Gateway est injoignable au moment du scan (sinon NAV lue chez IBKR)
MIN_SCORE=0                  # le score classe seulement ; les portes gamma et volatilité décident (backtest)
MAX_TICKETS_PER_RUN=3        # au plus N tickets par scan (et MAX_NEW_ORDERS_PER_DAY par jour, partagé avec le robot)
LOOKBACK_MINUTES=90          # fenêtre de flux analysée à chaque heure
MIN_PREMIUM_ALERT=50000      # prime minimale d'une alerte de flux retenue
MIN_MARKETCAP=2000000000     # capitalisation minimale (ETF exemptés)
MIN_DTE=21                   # fenêtre d'échéances des spreads
MAX_DTE=50
IV_RANK_CREDIT=1.01          # crédit désactivé : non validé par le backtest
MAX_RATIO_IV=1.2             # IV30 / volatilité prévue (HAR) maximale pour acheter un spread
MAX_BORROW_FEE_BEAR=0.10     # coût d'emprunt au-delà duquel un trade baissier est refusé
COOLDOWN_DAYS=3              # pas de nouveau ticket sur un titre proposé dans les N derniers jours
REQUIRE_GAMMA_SETUP=true     # seul setup à espérance non négative mesurée (reports/backtest/synthese.md)
TRIAL_SIZE=1                 # contrats par trade tant que 50 trades réels ne sont pas journalisés (0 = sans plafond)
HOLD_DAYS=10                 # sortie temps : N jours calendaires après l'entrée (effet du flux : quelques jours)
EXCLUDE_SYMBOLS=             # ex. TSLA,GME : jamais proposés
SCAN_MINUTE=5                # scans à 10h05, 11h05 … 15h05 (New York), jours ouvrés
